  "procedure": [
    {
      "step": 1,
      "title": "Finalize and freeze the only R132 delivery",
      "action": "Complete R132 compile/sign/preservation/identity checks first; bind final source/APK/markers and four regenerated IDs. Use the four fixed controller canonicals and unchanged cores/options/capacities above.",
      "expected": "runtime-final.json + package-final.json + canonical receipt + full source/compilation/preservation receipts; exact private original receipt pair for current helpers or a separately sealed administrative pair, with original provenance retained; PS3/PS4 offline; no secrets/binaries in Git"
    },
    {
      "step": 2,
      "title": "Observe production and install the exact administrative scripts",
      "action": "Resolve active configuration/ExecStart, scanner Type=oneshot, actual module.__file__ and library-tools. Human operator pauses only new scanner timer dispatches, lets current scanner finish, publishes the verified module/operator, verifies a fresh Python process and restores timer. Record native authorization, hashes and active API release/DLL/PID/flags; no API restart.",
      "requiredScriptSha256": {
        "cadastrar-motor-online-station.py": "a3c81e0c379984d6b7736f79ce963c73a3f3250883f6304a32b5c6cfda73a096",
        "station_online_profiles.py": "3d5d5b5563e2a6825ab9e798da80313cdbf2640522bc4dfd6b47e25c7f69eae1"
      },
      "requiredHelperSha256": {
        "build_incoming_manifest.py": "362bcae9d8915f7f43aac4c48d06b35bdf57efc88d6acb9199aa06e3a0231426",
        "extract_private_server_artifacts.py": "27053b843d763adcf570e859b2c8658e216dbf6f80963b600fa5326958f70ef4",
        "merge_scoped_modes.py": "ddac598ca1671e6d682b626866a3b1984eb88c5ff7d677c7b4cd563a6a677783"
      }
    },
    {
      "step": 3,
      "title": "Generate manifest and obtain the private kit once",
      "commands": [
        "python3 \"$TOOLS/build_incoming_manifest.py\" --runtime-receipt \"$RUNTIME_ORIGINAL\" --package-receipt \"$PACKAGE_ORIGINAL\" --output \"$PREPARATION/incoming-engine-manifest.json\" --profile-receipt \"$PREPARATION/profile-canonical-receipt.json\"",
        "python3 \"$TOOLS/extract_private_server_artifacts.py\" --apk \"$APK_FINAL\" --package-receipt \"$PACKAGE_ORIGINAL\" --runtime-receipt \"$RUNTIME_ORIGINAL\" --output \"$KIT_PRIVADO_ATUAL\""
      ],
      "expected": "DELIVERY contains the helper-consumable byte-exact receipt pair, not a sanitized file whose SHA differs from its original identity seal. Extractor checks complete APK SHA/bytes, identity seal, signature/alignment receipt, six core/runtime bytes and all dependencies; copies only six libraries. Operator confirms actual private receipt, never infer from Git."
    },
    {
      "step": 4,
      "title": "Review exact modes against the current catalog",
      "command": "python3 \"$TOOLS/merge_scoped_modes.py\" --catalog \"$CATALOG\" --profiles \"$PROFILES\" --modes \"$MODES\" --runtime-receipt \"$RUNTIME_ORIGINAL\" --profiles-module \"$PROFILES_MODULE\" --decisions \"$REVIEW_LEDGER\" --output \"$PREPARATION/prepared-modes-merged.json\" --audit-json \"$PREPARATION/scoped-mode-audit.json\"",
      "expected": "Exact old prefix preserved. Native controller/content/core/canonical match for migration, explicit PSX HLE evidence. One accepted/refused edition/mode matrix; no invented item/hash/capacity."
    },
    {
      "step": 5,
      "title": "Apply one sealed candidate through native administration",
      "command": "pkexec python3 \"$SERVER_OPERATOR\" install --config \"$CONFIG\" --incoming \"$PREPARATION/incoming-engine-manifest.json\" --artifacts \"$ARTIFACTS\" --mode-additions \"$PREPARATION/prepared-modes-merged.json\" --output \"$CANDIDATE\"",
      "expected": "Fresh candidate directory; active catalog/profile/engine/mode baselines revalidated under scan.lock. Existing records retained; modes/engines then profiles atomic publication and exact rollback. Reprepare if baseline changed, no permissive override."
    },
    {
