# Restore original build paths in debug/macro metadata. Runtime options are intact.
if(NOT PROJECT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  return()
endif()
if(NOT DEFINED STATION_ORIGINAL_BUILD OR NOT DEFINED STATION_ORIGINAL_STAGE)
  message(FATAL_ERROR "Closed original build/stage are required")
endif()
if(NOT DEFINED STATION_PACKAGING_ASSET_DIR OR NOT IS_ABSOLUTE "${STATION_PACKAGING_ASSET_DIR}")
  message(FATAL_ERROR "An explicit fresh packaging asset output is required")
endif()
string(TOLOWER "${STATION_ORIGINAL_STAGE}" station_original_stage_lower)
string(TOLOWER "${STATION_PACKAGING_ASSET_DIR}" station_assets_lower)
cmake_path(IS_PREFIX station_original_stage_lower "${station_assets_lower}" NORMALIZE station_assets_under_source)
if(station_assets_under_source)
  message(FATAL_ERROR "Packaging output must not be in the original source stage")
endif()

function(station_guard_source_write candidate)
  string(TOLOWER "${candidate}" station_candidate_lower)
  if("${candidate}" MATCHES "\\$<")
    string(FIND "${station_candidate_lower}" "${station_original_stage_lower}" station_stage_mention)
    if(NOT station_stage_mention EQUAL -1)
      message(FATAL_ERROR "Generator output mentions protected original source: ${candidate}")
    endif()
    return()
  endif()
  if(ARGC GREATER 1)
    set(station_write_base "${ARGV1}")
  else()
    set(station_write_base "${CMAKE_CURRENT_SOURCE_DIR}")
  endif()
  get_filename_component(station_write_absolute "${candidate}" ABSOLUTE BASE_DIR "${station_write_base}")
  string(TOLOWER "${station_write_absolute}" station_write_lower)
  cmake_path(IS_PREFIX station_original_stage_lower "${station_write_lower}" NORMALIZE station_protected_write)
  if(station_protected_write)
    message(FATAL_ERROR "Write/remove in the protected original source stage refused: ${candidate}")
  endif()
  string(TOLOWER "${CMAKE_BINARY_DIR}" station_binary_lower)
  cmake_path(IS_PREFIX station_binary_lower "${station_write_lower}" NORMALIZE station_under_new_build)
  cmake_path(IS_PREFIX station_assets_lower "${station_write_lower}" NORMALIZE station_under_new_assets)
  if(NOT station_under_new_build AND NOT station_under_new_assets)
    message(FATAL_ERROR "CMake write outside the fresh build/packaging outputs refused: ${candidate}")
  endif()
endfunction()

# The original JNI CMake script packages Sys assets inside its source directory.
# Redirect exactly its mkdir, Sys removal, Sys copy and Themes removal. No source
# deletion/copy is ever delegated. All other source-stage mutations fail closed.
function(file)
  string(TOUPPER "${ARGV0}" station_operation)
  set(station_assets "${STATION_ORIGINAL_STAGE}/Source/Android/app/src/main/assets")
  if(ARGC GREATER 1)
    get_filename_component(station_first "${ARGV1}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    cmake_path(NORMAL_PATH station_first)
  endif()
  set(station_redirect "")
  if(station_operation STREQUAL "REMOVE" AND ARGC EQUAL 2 AND station_first STREQUAL "${STATION_ORIGINAL_STAGE}/Source/Core/Common/scmrev.h")
    # Original REMOVE of this absent Visual Studio header has no effect. Never
    # delegate deletion in the source stage; refuse if the closed absence drifts.
    if(EXISTS "${station_first}" OR IS_SYMLINK "${station_first}")
      message(FATAL_ERROR "Protected in-tree scmrev.h must remain absent")
    endif()
    get_property(station_seen GLOBAL PROPERTY STATION_ABSENT_SCMREV_NOOP)
    if(station_seen)
      message(FATAL_ERROR "Original absent scmrev.h removal repeated unexpectedly")
    endif()
    set_property(GLOBAL PROPERTY STATION_ABSENT_SCMREV_NOOP TRUE)
    return()
  elseif(station_operation STREQUAL "MAKE_DIRECTORY" AND ARGC EQUAL 2 AND station_first STREQUAL station_assets)
    _file(MAKE_DIRECTORY "${STATION_PACKAGING_ASSET_DIR}")
    set(station_redirect mkdir)
  elseif(station_operation STREQUAL "REMOVE_RECURSE" AND ARGC EQUAL 2 AND station_first STREQUAL "${station_assets}/Sys")
    _file(REMOVE_RECURSE "${STATION_PACKAGING_ASSET_DIR}/Sys")
    set(station_redirect remove_sys)
  elseif(station_operation STREQUAL "COPY" AND ARGC EQUAL 4 AND ARGV2 STREQUAL "DESTINATION" AND station_first STREQUAL "${STATION_ORIGINAL_STAGE}/Data/Sys")
    get_filename_component(station_destination "${ARGV3}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    cmake_path(NORMAL_PATH station_destination)
    if(station_destination STREQUAL station_assets)
      _file(COPY "${STATION_ORIGINAL_STAGE}/Data/Sys" DESTINATION "${STATION_PACKAGING_ASSET_DIR}")
      set(station_redirect copy_sys)
    endif()
  elseif(station_operation STREQUAL "REMOVE_RECURSE" AND ARGC EQUAL 2 AND station_first STREQUAL "${station_assets}/Sys/Themes")
    _file(REMOVE_RECURSE "${STATION_PACKAGING_ASSET_DIR}/Sys/Themes")
    set(station_redirect remove_themes)
  endif()
  if(NOT station_redirect STREQUAL "")
    get_property(station_seen GLOBAL PROPERTY "STATION_PACKAGING_${station_redirect}")
    if(station_seen)
      message(FATAL_ERROR "Original packaging command was repeated unexpectedly")
    endif()
    set_property(GLOBAL PROPERTY "STATION_PACKAGING_${station_redirect}" TRUE)
    return()
  endif()

  if(station_operation MATCHES "^(DOWNLOAD|UPLOAD)$")
    message(FATAL_ERROR "Network access from native CMake is refused")
  elseif(station_operation MATCHES "^(WRITE|APPEND|LOCK)$")
    station_guard_source_write("${ARGV1}")
  elseif(station_operation MATCHES "^(RENAME|COPY_FILE|CREATE_LINK)$")
    if(station_operation STREQUAL "RENAME")
      station_guard_source_write("${ARGV1}")
    endif()
    station_guard_source_write("${ARGV2}")
  elseif(station_operation MATCHES "^(REMOVE|REMOVE_RECURSE|MAKE_DIRECTORY|TOUCH|TOUCH_NOCREATE|CHMOD|CHMOD_RECURSE)$")
    math(EXPR station_last "${ARGC} - 1")
    foreach(station_index RANGE 1 ${station_last})
      set(station_value "${ARGV${station_index}}")
      if(station_value MATCHES "^(RESULT|PERMISSIONS|FILE_PERMISSIONS|DIRECTORY_PERMISSIONS)$")
        break()
      endif()
      station_guard_source_write("${station_value}")
    endforeach()
  elseif(station_operation MATCHES "^(COPY|INSTALL|ARCHIVE_EXTRACT)$")
    set(station_destination_seen FALSE)
    math(EXPR station_last "${ARGC} - 1")
    foreach(station_index RANGE 1 ${station_last})
      if("${ARGV${station_index}}" STREQUAL "DESTINATION")
        math(EXPR station_next "${station_index} + 1")
        station_guard_source_write("${ARGV${station_next}}")
        set(station_destination_seen TRUE)
      endif()
    endforeach()
    if(NOT station_destination_seen)
      message(FATAL_ERROR "An explicit non-source destination is required")
    endif()
  elseif(station_operation MATCHES "^(GENERATE|CONFIGURE|ARCHIVE_CREATE)$")
    set(station_output_seen FALSE)
    math(EXPR station_last "${ARGC} - 1")
    foreach(station_index RANGE 1 ${station_last})
      if("${ARGV${station_index}}" STREQUAL "OUTPUT")
        math(EXPR station_next "${station_index} + 1")
        station_guard_source_write("${ARGV${station_next}}" "${CMAKE_CURRENT_BINARY_DIR}")
        set(station_output_seen TRUE)
      endif()
    endforeach()
    if(NOT station_output_seen)
      message(FATAL_ERROR "Explicit generated output required")
    endif()
  elseif(NOT station_operation MATCHES "^(READ|STRINGS|GLOB|GLOB_RECURSE|MD5|SHA1|SHA224|SHA256|SHA384|SHA512|SHA3_224|SHA3_256|SHA3_384|SHA3_512|SIZE|TIMESTAMP|REAL_PATH|READ_SYMLINK|RELATIVE_PATH|TO_CMAKE_PATH|TO_NATIVE_PATH)$")
    message(FATAL_ERROR "Unreviewed native CMake file operation: ${station_operation}")
  endif()

  # Bracket-quote each original argument to preserve semicolons/newlines exactly.
  set(station_forward "_file(")
  math(EXPR station_last "${ARGC} - 1")
  foreach(station_index RANGE 0 ${station_last})
    set(station_value "${ARGV${station_index}}")
    set(station_equals "=")
    string(FIND "${station_value}" "]${station_equals}]" station_close_found)
    while(NOT station_close_found EQUAL -1)
      string(APPEND station_equals "=")
      string(FIND "${station_value}" "]${station_equals}]" station_close_found)
    endwhile()
    string(APPEND station_forward " [${station_equals}[${station_value}]${station_equals}]")
  endforeach()
  string(APPEND station_forward ")")
  cmake_language(EVAL CODE "${station_forward}")
  if(station_operation MATCHES "^(READ|STRINGS|MD5|SHA1|SHA224|SHA256|SHA384|SHA512|SHA3_224|SHA3_256|SHA3_384|SHA3_512|SIZE|TIMESTAMP|REAL_PATH|READ_SYMLINK|TO_CMAKE_PATH|TO_NATIVE_PATH)$")
    set("${ARGV2}" "${${ARGV2}}" PARENT_SCOPE)
  elseif(station_operation MATCHES "^(GLOB|GLOB_RECURSE|RELATIVE_PATH)$")
    set("${ARGV1}" "${${ARGV1}}" PARENT_SCOPE)
  endif()
endfunction()

function(configure_file input output)
  station_guard_source_write("${output}" "${CMAKE_CURRENT_BINARY_DIR}")
  # All existing configure_file arguments are path/options, not generated code.
  _configure_file("${input}" "${output}" ${ARGN})
endfunction()

function(add_custom_command)
  set(station_collect_outputs FALSE)
  foreach(station_value IN LISTS ARGV)
    if(station_value MATCHES "^(OUTPUT|BYPRODUCTS|DEPFILE)$")
      set(station_collect_outputs TRUE)
    elseif(station_value MATCHES "^(COMMAND|DEPENDS|MAIN_DEPENDENCY|IMPLICIT_DEPENDS|WORKING_DIRECTORY|COMMENT|VERBATIM|APPEND|COMMAND_EXPAND_LISTS|JOB_POOL|JOB_SERVER_AWARE|USES_TERMINAL|CODEGEN|TARGET|PRE_BUILD|PRE_LINK|POST_BUILD)$")
      set(station_collect_outputs FALSE)
    elseif(station_collect_outputs)
      station_guard_source_write("${station_value}" "${CMAKE_CURRENT_BINARY_DIR}")
    endif()
  endforeach()
  set(station_forward "_add_custom_command(")
  math(EXPR station_last "${ARGC} - 1")
  foreach(station_index RANGE 0 ${station_last})
    set(station_value "${ARGV${station_index}}")
    set(station_equals "=")
    string(FIND "${station_value}" "]${station_equals}]" station_close_found)
    while(NOT station_close_found EQUAL -1)
      string(APPEND station_equals "=")
      string(FIND "${station_value}" "]${station_equals}]" station_close_found)
    endwhile()
    string(APPEND station_forward " [${station_equals}[${station_value}]${station_equals}]")
  endforeach()
  string(APPEND station_forward ")")
  cmake_language(EVAL CODE "${station_forward}")
endfunction()

function(station_verify_asset_redirection)
  foreach(station_action mkdir remove_sys copy_sys remove_themes)
    get_property(station_seen GLOBAL PROPERTY "STATION_PACKAGING_${station_action}")
    if(NOT station_seen)
      message(FATAL_ERROR "A reviewed Android packaging command did not run: ${station_action}")
    endif()
  endforeach()
  get_property(station_seen GLOBAL PROPERTY STATION_ABSENT_SCMREV_NOOP)
  if(NOT station_seen)
    message(FATAL_ERROR "Reviewed absent scmrev.h no-op did not run")
  endif()
endfunction()
cmake_language(DEFER CALL station_verify_asset_redirection)

add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX>:-ffile-prefix-map=${CMAKE_BINARY_DIR}=${STATION_ORIGINAL_BUILD}>")

if(DEFINED STATION_MAIN_ANDROID_OVERLAY AND NOT STATION_MAIN_ANDROID_OVERLAY STREQUAL "")
  get_filename_component(station_overlay_parent "${STATION_MAIN_ANDROID_OVERLAY}" DIRECTORY)
  add_compile_options("$<$<COMPILE_LANGUAGE:C,CXX>:-ffile-prefix-map=${station_overlay_parent}=${STATION_ORIGINAL_STAGE}/Source/Android/jni>")
  function(station_replace_main_android)
    if(NOT TARGET main)
      message(FATAL_ERROR "The original Dolphin main target is absent")
    endif()
    get_target_property(station_source_dir main SOURCE_DIR)
    get_target_property(station_original_sources main SOURCES)
    set(station_new_sources)
    set(station_replaced 0)
    foreach(station_source IN LISTS station_original_sources)
      get_filename_component(station_absolute "${station_source}" ABSOLUTE BASE_DIR "${station_source_dir}")
      if(station_absolute STREQUAL "${STATION_ORIGINAL_STAGE}/Source/Android/jni/MainAndroid.cpp")
        list(APPEND station_new_sources "${STATION_MAIN_ANDROID_OVERLAY}")
        math(EXPR station_replaced "${station_replaced} + 1")
      else()
        list(APPEND station_new_sources "${station_absolute}")
      endif()
    endforeach()
    if(NOT station_replaced EQUAL 1)
      message(FATAL_ERROR "Exactly one original MainAndroid.cpp must be replaced")
    endif()
    set_property(TARGET main PROPERTY SOURCES "${station_new_sources}")
  endfunction()
  cmake_language(DEFER CALL station_replace_main_android)
endif()
