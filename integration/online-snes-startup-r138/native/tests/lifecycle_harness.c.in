/* Production functions below are extracted verbatim; Android/JNI are bounded fixtures. */
#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>

static LONG checks;
#define CHECK(x) do { InterlockedIncrement(&checks); if (!(x)) { \
    fprintf(stderr,"FAIL line=%d condition=%s\n",__LINE__,#x); exit(2); } } while (0)
typedef SRWLOCK slock_t;
typedef CONDITION_VARIABLE scond_t;
typedef SRWLOCK pthread_mutex_t;
#define PTHREAD_MUTEX_INITIALIZER SRWLOCK_INIT
static void pthread_mutex_lock(pthread_mutex_t *m) { AcquireSRWLockExclusive(m); }
static void pthread_mutex_unlock(pthread_mutex_t *m) { ReleaseSRWLockExclusive(m); }
static slock_t *slock_new(void) { slock_t *m=malloc(sizeof(*m)); CHECK(m); InitializeSRWLock(m); return m; }
static scond_t *scond_new(void) { scond_t *c=malloc(sizeof(*c)); CHECK(c); InitializeConditionVariable(c); return c; }
static void slock_lock(slock_t *m) { AcquireSRWLockExclusive(m); }
static void slock_unlock(slock_t *m) { ReleaseSRWLockExclusive(m); }
static void scond_wait(scond_t *c,slock_t *m) { CHECK(SleepConditionVariableSRW(c,m,5000,0)); }
static void scond_broadcast(scond_t *c) { WakeAllConditionVariable(c); }
static void scond_free(scond_t *c) { free(c); }
static void slock_free(slock_t *m) { free(m); }
struct test_thread { HANDLE handle; };
struct mock_looper { LONG dead; };
struct mock_config { LONG deleted; };
typedef struct ANativeActivity { void *instance,*clazz; } ANativeActivity;
typedef int JNIEnv;
struct android_app {
    slock_t *mutex; scond_t *cond; struct test_thread *thread;
    ANativeActivity *activity; void *savedState; size_t savedStateSize;
    struct mock_looper *looper; struct mock_config *config; void *inputQueue;
    int destroyed,stationQuitRequested,msgread,msgwrite,onRetroArchExit,have_saf;
};
struct test_state {
    struct android_app *app; ANativeActivity activity;
    struct mock_looper looper; struct mock_config config; struct test_thread worker;
    HANDLE startGate,returnGate,cleanupPublished,workerDone;
    int mode;
    LONG wakeCalls,staleWakes,callbacks,detaches,invalidConfigDeletes,safDeinits;
    LONG appFrees,saveFrees,joinCalls,joinCompleted,releaseCalls,closeCalls,logs;
};
static struct test_state *current;
static struct android_app *g_android;
static pthread_mutex_t station_activity_mutex=PTHREAD_MUTEX_INITIALIZER;
static ANativeActivity *station_activity_owner;
static struct android_app *station_activity_app;
static JNIEnv fake_env;
static JNIEnv *jni_thread_getenv(void) { return &fake_env; }
static void mock_callback(JNIEnv *env,void *clazz,int method) {
    (void)env; (void)clazz; (void)method; InterlockedIncrement(&current->callbacks);
}
#define CALL_VOID_METHOD(env,clazz,method) mock_callback(env,clazz,method)
#define HAVE_SAF 1
static void retro_vfs_deinit_saf(void) { InterlockedIncrement(&current->safDeinits); }
static void ALooper_wake(struct mock_looper *looper) {
    InterlockedIncrement(&current->wakeCalls);
    if (InterlockedCompareExchange(&looper->dead,0,0)) InterlockedIncrement(&current->staleWakes);
}
static void AInputQueue_detachLooper(void *queue) { CHECK(queue); InterlockedIncrement(&current->detaches); }
static void AConfiguration_delete(struct mock_config *config) {
    if (!config) { InterlockedIncrement(&current->invalidConfigDeletes); return; }
    InterlockedIncrement(&config->deleted);
}
#define ANDROID_LOG_INFO 4
static int __android_log_print(int level,const char *tag,const char *format,...) {
    (void)level; CHECK(!strcmp(tag,"StationNative")); CHECK(!strcmp(format,"runloop-return result=%d"));
    InterlockedIncrement(&current->logs); return 0;
}
static void station_multiplayer_end_launch(void) {
    CHECK(current->joinCompleted==1); CHECK(current->appFrees==1);
    InterlockedIncrement(&current->releaseCalls);
}
static void sthread_join(struct test_thread *thread) {
    InterlockedIncrement(&current->joinCalls);
    CHECK(WaitForSingleObject(thread->handle,5000)==WAIT_OBJECT_0);
    CHECK(WaitForSingleObject(current->workerDone,0)==WAIT_OBJECT_0);
    InterlockedExchange(&current->joinCompleted,1);
    CHECK(CloseHandle(thread->handle)); thread->handle=NULL;
}
static void mock_free(void *pointer) {
    if (!pointer) return;
    if (pointer==current->app) {
        CHECK(current->joinCompleted==1);
        CHECK(WaitForSingleObject(current->workerDone,0)==WAIT_OBJECT_0);
        InterlockedIncrement(&current->appFrees);
    } else InterlockedIncrement(&current->saveFrees);
    free(pointer);
}
static int mock_close(int fd) { CHECK(fd==101||fd==102); InterlockedIncrement(&current->closeCalls); return 0; }
static int rarch_main(int argc,char *argv[],void *data);
static void android_app_destroy(struct android_app *android_app);
#define free mock_free
#define close mock_close

/* @PRODUCTION_FUNCTIONS@ */

#undef free
#undef close

static int rarch_main(int argc,char *argv[],void *data) {
    struct android_app *app=data;
    CHECK(argc==1); CHECK(!strcmp(argv[0],"retroarch"));
    CHECK(WaitForSingleObject(current->startGate,5000)==WAIT_OBJECT_0);
    if (current->mode!=1) android_app_destroy(app);
    if (current->mode==2) android_app_destroy(app);
    CHECK(SetEvent(current->cleanupPublished));
    if (current->mode==3) CHECK(WaitForSingleObject(current->returnGate,5000)==WAIT_OBJECT_0);
    return current->mode==1 ? 1 : 0;
}
static DWORD WINAPI worker_entry(void *data) {
    android_app_entry(data);
    /* Android releases the thread's borrowed looper at native thread exit. */
    InterlockedExchange(&current->looper.dead,1);
    CHECK(SetEvent(current->workerDone));
    return 0;
}
static DWORD WINAPI destroy_entry(void *data) { onDestroy(data); return 0; }
static DWORD WINAPI quit_entry(void *data) {
    struct android_app *app=data;
    unsigned i;
    for(i=0;i<2000;i++) (void)android_app_request_quit(app);
    CHECK(WaitForSingleObject(current->workerDone,5000)==WAIT_OBJECT_0);
    for(i=0;i<128;i++) {
        bool accepted=android_app_request_quit(app);
        CHECK(current->staleWakes==0); CHECK(!accepted);
    }
    return 0;
}
static void initialize_state(struct test_state *s,int mode) {
    memset(s,0,sizeof(*s)); current=s; s->mode=mode;
    s->startGate=CreateEvent(NULL,TRUE,FALSE,NULL); s->returnGate=CreateEvent(NULL,TRUE,FALSE,NULL);
    s->cleanupPublished=CreateEvent(NULL,TRUE,FALSE,NULL); s->workerDone=CreateEvent(NULL,TRUE,FALSE,NULL);
    CHECK(s->startGate&&s->returnGate&&s->cleanupPublished&&s->workerDone);
    s->app=calloc(1,sizeof(*s->app)); CHECK(s->app);
    s->app->mutex=slock_new(); s->app->cond=scond_new(); s->app->thread=&s->worker;
    s->app->activity=&s->activity; s->app->savedState=malloc(8); CHECK(s->app->savedState);
    s->app->savedStateSize=8; s->app->looper=&s->looper; s->app->config=&s->config;
    s->app->inputQueue=s; s->app->onRetroArchExit=1; s->app->have_saf=1;
    s->app->msgread=101; s->app->msgwrite=102;
    s->activity.instance=s->app; s->activity.clazz=s;
    g_android=s->app; station_activity_owner=&s->activity; station_activity_app=s->app;
    s->worker.handle=CreateThread(NULL,0,worker_entry,s->app,0,NULL); CHECK(s->worker.handle);
}
static void wait_worker(struct test_state *s) {
    CHECK(WaitForSingleObject(s->workerDone,5000)==WAIT_OBJECT_0);
    CHECK(s->app->destroyed==1); CHECK(s->staleWakes==0);
}
static void verify_cleanup(struct test_state *s,bool pointers) {
    CHECK(s->callbacks==1); CHECK(s->detaches==1); CHECK(s->config.deleted==1);
    CHECK(s->invalidConfigDeletes==0); CHECK(s->safDeinits==1); CHECK(s->saveFrees==1);
    CHECK(s->staleWakes==0);
    if (pointers) { CHECK(!s->app->looper); CHECK(!s->app->config); CHECK(!s->app->inputQueue); }
}
static void close_state(struct test_state *s) {
    CHECK(s->activity.instance==NULL); CHECK(s->appFrees==1); CHECK(s->joinCompleted==1);
    CHECK(s->releaseCalls==1); CHECK(s->closeCalls==2); CHECK(g_android==NULL);
    CHECK(station_activity_owner==NULL); CHECK(station_activity_app==NULL);
    CHECK(CloseHandle(s->startGate)); CHECK(CloseHandle(s->returnGate));
    CHECK(CloseHandle(s->cleanupPublished)); CHECK(CloseHandle(s->workerDone));
}
static void simple_test(const char *name) {
    struct test_state s;
    int mode=!strcmp(name,"early") ? 1 : (!strcmp(name,"double") ? 2 : 0);
    initialize_state(&s,mode); CHECK(SetEvent(s.startGate));
    CHECK(WaitForSingleObject(s.workerDone,5000)==WAIT_OBJECT_0);
    /* With the baseline, this late quit reaches a thread-owned stale looper. */
    {
        bool accepted=android_app_request_quit(s.app);
        CHECK(s.staleWakes==0); CHECK(!accepted);
    }
    wait_worker(&s); verify_cleanup(&s,false);
    if (strcmp(name,"normal")) verify_cleanup(&s,true);
    onDestroy(&s.activity); close_state(&s);
}
static void race_test(void) {
    unsigned i;
    for(i=0;i<300;i++) {
        struct test_state s; HANDLE requester;
        initialize_state(&s,1);
        requester=CreateThread(NULL,0,quit_entry,s.app,0,NULL); CHECK(requester);
        CHECK(SetEvent(s.startGate));
        CHECK(WaitForSingleObject(requester,5000)==WAIT_OBJECT_0); CHECK(CloseHandle(requester));
        wait_worker(&s); verify_cleanup(&s,true);
        onDestroy(&s.activity); close_state(&s);
    }
}
static void join_test(void) {
    struct test_state s; HANDLE destroyer;
    initialize_state(&s,3); CHECK(SetEvent(s.startGate));
    CHECK(WaitForSingleObject(s.cleanupPublished,5000)==WAIT_OBJECT_0);
    verify_cleanup(&s,false);
    destroyer=CreateThread(NULL,0,destroy_entry,&s.activity,0,NULL); CHECK(destroyer);
    Sleep(20);
    CHECK(s.appFrees==0); CHECK(s.releaseCalls==0);
    CHECK(WaitForSingleObject(destroyer,0)==WAIT_TIMEOUT);
    CHECK(SetEvent(s.returnGate));
    CHECK(WaitForSingleObject(destroyer,5000)==WAIT_OBJECT_0); CHECK(CloseHandle(destroyer));
    verify_cleanup(&s,false); close_state(&s);
}
int main(int argc,char **argv) {
    CHECK(argc==2);
    if (!strcmp(argv[1],"race")) race_test();
    else if (!strcmp(argv[1],"join")) join_test();
    else simple_test(argv[1]);
    printf("PASS scenario=%s checks=%ld\n",argv[1],checks); return 0;
}
