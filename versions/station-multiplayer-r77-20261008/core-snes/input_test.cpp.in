#include <libretro.h>
#include <array>
#include <climits>
#include <cstdint>
#include <cstdlib>
#include <iostream>
#include <vector>

#define RETRO_DEVICE_JOYPAD_MULTITAP RETRO_DEVICE_SUBCLASS(RETRO_DEVICE_JOYPAD, 0)
#define RETRO_DEVICE_LIGHTGUN_SUPER_SCOPE RETRO_DEVICE_SUBCLASS(RETRO_DEVICE_LIGHTGUN, 0)
#define RETRO_DEVICE_LIGHTGUN_JUSTIFIER RETRO_DEVICE_SUBCLASS(RETRO_DEVICE_LIGHTGUN, 1)
#define RETRO_DEVICE_LIGHTGUN_JUSTIFIERS RETRO_DEVICE_SUBCLASS(RETRO_DEVICE_LIGHTGUN, 2)

namespace SuperFamicom { struct Input { @DEVICE_ENUM@ @JOYPAD_ENUM@ }; }
using Device=SuperFamicom::Input::Device;
using Input=SuperFamicom::Input;
using uint2=unsigned;
using Call=std::array<unsigned,4>;
static std::vector<Call> calls;
static std::array<std::array<int16_t,12>,8> states{};
static unsigned polls=0,checks=0,baselineMissing=0,isolatedButtons=0,serialScans=0;
static void require(bool ok,const char* message){checks++;if(!ok){std::cerr<<message<<'\n';std::exit(1);}}
static void poll(){polls++;}
static int16_t state(unsigned port,unsigned device,unsigned index,unsigned id){calls.push_back({port,device,index,id});return port<states.size()&&id<12?states[port][id]:0;}
struct CallbacksBase {
    retro_input_poll_t pinput_poll=poll;
    retro_input_state_t pinput_state=state;
    bool input_polled=false;
    virtual int16_t inputPoll(unsigned,unsigned,unsigned)=0;
    virtual ~CallbacksBase()=default;
};
@CALLBACK_CLASSES@

struct MultitapFixture {
    bool port=true,latched=false,selected=true;
    unsigned counter1=0,counter2=0;
    CallbacksBase* interface=nullptr;
    bool iobit(){return selected;}
    uint2 data();void latch(bool);
};
@MULTITAP_METHODS@

static void clear(){calls.clear();polls=0;for(auto& row:states)row.fill(0);}
static void direct(){
    Fixed fixed;Baseline baseline;
    for(unsigned player=0;player<5;player++)for(unsigned button=0;button<12;button++){
        clear();fixed.input_polled=false;baseline.input_polled=false;states[player][button]=1;
        unsigned port=player==0?0:1,device=static_cast<unsigned>(player==0?Device::Joypad:Device::Multitap),id=player==0?button:(player-1)*12+button;
        int16_t actual=fixed.inputPoll(port,device,id);
        require(actual==1,"selected player/button must reach frontend");require(calls.size()==1&&calls[0]==Call{player,RETRO_DEVICE_JOYPAD,0,button},"exact frontend port/device/index/id");require(polls==1,"input poll invoked once");
        if(player>=2){calls.clear();require(baseline.inputPoll(port,device,id)==0,"baseline additional pads blocked");require(calls.empty(),"baseline blocked before frontend callback");baselineMissing++;}
        isolatedButtons++;
    }
    // Every button on every other pad remains independent; never mirror P1 into P3/P4.
    for(unsigned pressed=0;pressed<5;pressed++)for(unsigned button=0;button<12;button++){
        clear();states[pressed][button]=1;fixed.input_polled=false;
        for(unsigned queried=0;queried<5;queried++)for(unsigned b=0;b<12;b++){
            unsigned port=queried==0?0:1,device=static_cast<unsigned>(queried==0?Device::Joypad:Device::Multitap),id=queried==0?b:(queried-1)*12+b;
            require(fixed.inputPoll(port,device,id)==static_cast<int16_t>(queried==pressed&&b==button),"cross-player button isolation");
        }
        require(polls==1,"all pads share one input poll per emulated frame");
    }
}
static void nonMultitap(){
    const Device devices[]={Device::Joypad,Device::Mouse,Device::SuperScope,Device::Justifier,Device::Justifiers,Device::USART,Device::None};
    for(Device device:devices)for(unsigned port=0;port<2;port++)for(unsigned id=0;id<18;id++){
        clear();for(unsigned i=0;i<12;i++)states[port][i]=static_cast<int16_t>(i%2?-1234:1234);
        Baseline baseline;Fixed fixed;int16_t expected=baseline.inputPoll(port,static_cast<unsigned>(device),id);auto old=calls;unsigned oldPolls=polls;
        calls.clear();polls=0;int16_t actual=fixed.inputPoll(port,static_cast<unsigned>(device),id);
        require(actual==expected&&calls==old&&polls==oldPolls,"non-multitap forwarding exactly preserved");
    }
    Fixed fixed;
    for(unsigned id:std::array<unsigned,5>{48,49,60,255,UINT_MAX}){
        clear();fixed.input_polled=false;require(fixed.inputPoll(1,static_cast<unsigned>(Device::Multitap),id)==0,"reject invalid adapter id");require(calls.empty()&&polls==0,"invalid id does not reach frontend");
    }
}
static void scan(){
    Fixed fixed;MultitapFixture adapter;adapter.interface=&fixed;
    for(unsigned pattern=0;pattern<64;pattern++){
        clear();fixed.input_polled=false;adapter.latched=false;adapter.counter1=0;adapter.counter2=0;
        for(unsigned player=0;player<5;player++)for(unsigned button=0;button<12;button++)states[player][button]=((pattern*7+player*11+button*3)>>(button%5))&1;
        for(unsigned select=0;select<2;select++){
            adapter.selected=select!=0;const unsigned first=select?1:3;
            for(unsigned b=0;b<12;b++)require(adapter.data()==static_cast<unsigned>(states[first][b]|(states[first+1][b]<<1)),"actual SNES serial pair matches distinct adapter pads");
            for(unsigned b=12;b<16;b++)require(adapter.data()==0,"adapter signature clocks 12 through 15 preserved");
            require(adapter.data()==3,"adapter saturated counter signature preserved");serialScans++;
        }
        require(calls.size()==48&&polls==1,"48 adapter button samples and one frontend poll");
        adapter.latch(true);require(adapter.data()==2,"latched adapter detection signature preserved");require(adapter.counter1==0&&adapter.counter2==0,"latch resets both banks");
        adapter.latch(false);require(!adapter.latched&&adapter.counter1==0&&adapter.counter2==0,"unlatch resets scan banks");
    }
}
int main(){
    require(static_cast<unsigned>(SuperFamicom::Input::JoypadID::B)==RETRO_DEVICE_ID_JOYPAD_B,"Mercury B order");
    require(static_cast<unsigned>(SuperFamicom::Input::JoypadID::Start)==RETRO_DEVICE_ID_JOYPAD_START,"Mercury Start order");
    require(static_cast<unsigned>(SuperFamicom::Input::JoypadID::R)==RETRO_DEVICE_ID_JOYPAD_R,"Mercury R order");
    direct();nonMultitap();scan();
    std::cout<<"{\"checks\":"<<checks<<",\"isolatedButtons\":"<<isolatedButtons<<",\"baselineBlockedButtons\":"<<baselineMissing<<",\"serialScans\":"<<serialScans<<",\"androidExecuted\":false,\"romUsed\":false}"<<'\n';
}
