+static int StationService(ENetHost* host, ENetEvent* event, enet_uint32 timeout)
+{
+  if (!Common::StationDolphin::Active())
+    return enet_host_service(host, event, timeout);
+  for (;;)
+  {
+    if (!Common::StationDolphin::Active() || Common::StationDolphin::HumanExitAllowed())
+      return 0;
+    const int result = enet_host_service(host, event, 100);
+    if (result != 0)
+      return result;
+  }
+}
