+PlayerId NetPlayServer::StationPlayerForSlot(unsigned int slot)
+{
+  std::lock_guard guard(m_crit.players);
+  for (const auto& [pid, player] : m_players)
+    if (player.socket && Common::StationDolphin::SlotForAddress(player.socket->address) == slot)
+      return pid;
+  return 0;
+}
+
+unsigned int NetPlayServer::StationRegisteredSlotMask()
+{
+  std::lock_guard guard(m_crit.players);
+  unsigned int mask = 0;
+  for (const auto& [pid, player] : m_players)
+  {
+    const auto slot = player.socket ? Common::StationDolphin::SlotForAddress(player.socket->address) : 0;
+    if (slot == 0 || (mask & (1u << slot)))
+      return 0;
+    mask |= 1u << slot;
+  }
+  return mask;
 }
 
